graph TD
    S[Service\nname: Report Generation\ntype: report\nprice: 50\nfreeLimit: 3\ndegreePricing: [{BE: 100}, {MBA: 75}]] --> P
    P[Payment\nuser, service, report\namount, gstAmount, totalAmount\nstatus: pending/completed/failed]
